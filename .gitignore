models/

# EPUBs generated on demand, not versioned
docs/epub/

# the machine's own settings, and the temporary copy written before replacing them
config.json
config.json.*

# the program's log (logs/jarvis.log, rotated)
logs/

# present while production is held (update in progress or deliberate stop)
HOLD


# dog gallery and crops (backlog 22)
dogs/

# devices paired with the PIN (R34): token hashes
devices.json

# bad detections the user reported (backlog 23)
reports/
